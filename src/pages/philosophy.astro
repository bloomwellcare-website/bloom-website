---
// 会社の理念ページ（パーパス・ビジョン・ミッション・バリュー・スピリット・スローガン）
import Layout from '../layouts/Layout.astro';
---
<Layout title="経営理念 | 訪問看護ステーション・居宅介護支援事業所ブルーム" description="合同会社SHIARAが運営する訪問看護ステーション・居宅介護支援事業所ブルームの、パーパス・ビジョン・ミッション・バリューをご紹介します。">

<!-- ヒーロー -->
<section style="background: linear-gradient(135deg, var(--pink-soft) 0%, var(--sky-soft) 100%); padding: 5rem 1.5rem 4rem;">
  <div class="si" style="text-align: center;">
    <div class="sen sen-p">Our Philosophy</div>
    <h1 class="sttl">私たちが大切にしていること</h1>
    <p class="sdesc">合同会社SHIARA（シアラ）が運営する、訪問看護ステーション・居宅介護支援事業所ブルームの理念です。</p>
  </div>
</section>

<!-- ✏️ パーパス -->
<section>
  <div class="si">
    <div class="shd">
      <div class="sen sen-p">Purpose</div>
      <h2 class="sttl">パーパス</h2>
    </div>
    <div style="max-width: 720px; margin: 0 auto; text-align: center;">
      <!-- ✏️ ここにパーパス（存在意義）を記載してください -->
      <p style="font-size: 17px; color: var(--txt-mid); line-height: 2;">（準備中：パーパスをここに記載します）</p>
    </div>
  </div>
</section>

<!-- ✏️ ビジョン -->
<section style="background: var(--pink-soft);">
  <div class="si">
    <div class="shd">
      <div class="sen sen-s">Vision</div>
      <h2 class="sttl">ビジョン</h2>
    </div>
    <div style="max-width: 720px; margin: 0 auto; text-align: center;">
      <!-- ✏️ ここにビジョン（目指す将来像）を記載してください -->
      <p style="font-size: 17px; color: var(--txt-mid); line-height: 2;">（準備中：ビジョンをここに記載します）</p>
    </div>
  </div>
</section>

<!-- ✏️ ミッション -->
<section>
  <div class="si">
    <div class="shd">
      <div class="sen sen-p">Mission</div>
      <h2 class="sttl">ミッション</h2>
    </div>
    <div style="max-width: 720px; margin: 0 auto; text-align: center;">
      <!-- ✏️ ここにミッション（果たすべき使命）を記載してください -->
      <p style="font-size: 17px; color: var(--txt-mid); line-height: 2;">（準備中：ミッションをここに記載します）</p>
    </div>
  </div>
</section>

<!-- ✏️ バリュー -->
<section style="background: var(--sky-soft);">
  <div class="si">
    <div class="shd">
      <div class="sen sen-s">Value</div>
      <h2 class="sttl">バリュー</h2>
      <p class="sdesc">私たちが行動する上で大切にする価値観です。</p>
    </div>
    <div class="feat-grid">
      <!-- ✏️ バリューの項目数・内容は自由に増減・編集してください -->
      <div class="feat-card"><div class="feat-num">01</div><div class="feat-ttl">（準備中）</div><p class="feat-txt">バリュー1の説明文をここに記載します。</p></div>
      <div class="feat-card"><div class="feat-num">02</div><div class="feat-ttl">（準備中）</div><p class="feat-txt">バリュー2の説明文をここに記載します。</p></div>
      <div class="feat-card"><div class="feat-num">03</div><div class="feat-ttl">（準備中）</div><p class="feat-txt">バリュー3の説明文をここに記載します。</p></div>
      <div class="feat-card"><div class="feat-num">04</div><div class="feat-ttl">（準備中）</div><p class="feat-txt">バリュー4の説明文をここに記載します。</p></div>
    </div>
  </div>
</section>

<!-- ✏️ スピリット -->
<section>
  <div class="si">
    <div class="shd">
      <div class="sen sen-p">Spirit</div>
      <h2 class="sttl">スピリット</h2>
    </div>
    <div style="max-width: 720px; margin: 0 auto; text-align: center;">
      <!-- ✏️ ここにスピリット（精神・姿勢）を記載してください -->
      <p style="font-size: 17px; color: var(--txt-mid); line-height: 2;">（準備中：スピリットをここに記載します）</p>
    </div>
  </div>
</section>

<!-- ✏️ スローガン -->
<div class="cta-section">
  <div class="cta-d1"></div><div class="cta-d2"></div>
  <!-- ✏️ ここにスローガンを記載してください -->
  <h2>（準備中：スローガンをここに記載します）</h2>
  <p class="hand-note" style="font-size: 17px; color: white; margin: 0; position: relative; z-index: 2;">With your happiness — あなたの幸せとともに</p>
</div>

<!-- 代表あいさつへの導線 -->
<section style="background: var(--cream);">
  <div class="si" style="text-align: center;">
    <a class="btn-flat" href="/#about">代表あいさつを見る →</a>
  </div>
</section>

</Layout>
