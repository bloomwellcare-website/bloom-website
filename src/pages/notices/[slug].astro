---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const files = import.meta.glob('../../data/notices/*.json', { eager: true });
  return Object.entries(files).map(([path, mod]) => {
    const slug = path.split('/').pop().replace('.json', '');
    return { params: { slug }, props: { notice: mod.default } };
  });
}

const { notice } = Astro.props;
const dateDisp = notice.date.replaceAll('-', '.');
---
<Layout title={`${notice.title} | 訪問看護ステーション・居宅介護支援事業所ブルーム`}>

<section style="background: linear-gradient(135deg, var(--sky-soft) 0%, var(--pink-soft) 100%); padding: 4rem 1.5rem 3rem;">
  <div class="si" style="max-width: 760px;">
    <div class="sen sen-s">Notice</div>
    <div style="font-size: 15px; color: var(--txt-muted); margin-bottom: 0.5rem;">{dateDisp}</div>
    <h1 class="sttl" style="font-size: clamp(24px,4vw,34px);">{notice.title}</h1>
  </div>
</section>

<section>
  <div class="si" style="max-width: 760px;">
    <p style="white-space: pre-line; font-size: 20px; line-height: 2; color: var(--txt-mid);">{notice.body}</p>
    <div style="margin-top: 3rem;">
      <a class="btn-flat" href="/notices">← お知らせ一覧に戻る</a>
    </div>
  </div>
</section>

</Layout>
